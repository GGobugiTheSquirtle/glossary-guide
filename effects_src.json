    {"id": "break", "kind": "proper", "sub": "ailment", "ko": "브레이크", "en": "Break", "jp": "ブレイク", "ko_re": "(?<!엘리멘탈 )(?<!웨폰 )브레이크", "en_re": "(?<!Elemental )(?<!Weapon )\\bBreak\\b", "jp_re": "(?<!エレメンタル)(?<!ウェポン)ブレイク(?![ドダ])",
